# Copy to .env next to docker-compose.yml and fill in. Never commit the filled copy.

# --- Django -------------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=generate-a-50-char-random-string
DJANGO_DEBUG=false
# ⚠ docs/DECISIONS.md O-4: which of the purchased domains (.com/.ai/.in) is primary is unconfirmed.
DJANGO_ALLOWED_HOSTS=app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database -----------------------------------------------------------------------------------
POSTGRES_DB=easykharcha
POSTGRES_USER=easykharcha
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://easykharcha:change-me@postgres:5432/easykharcha

# --- Redis / Celery -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Auth ---------------------------------------------------------------------------------------
PIN_LENGTH=4
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
LOGIN_THROTTLE_RATE=10/min

# --- Alerts -------------------------------------------------------------------------------------
# "logging" is the only working implementation. A WhatsApp BSP is not chosen yet (DECISIONS O-7).
ALERT_NOTIFIER=logging

# --- Bootstrap (used once by create_superadmin, then remove) ------------------------------------
SUPERADMIN_PHONE=
SUPERADMIN_NAME=
SUPERADMIN_PIN=
