# Copy to mobile/.env. .env is gitignored; this file is the only one that's committed.
# Optional for local dev — src/api/client.ts already defaults to the URL below if this file (or the
# variable) is absent. Only needed to point the app at a different backend.

EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# The public marketing site (landing/index.html) — web only. A signed-out visitor opening "/" is
# sent here, and /login and /signup link back to it. Defaults to the local landing server started
# by `npm run dev` if unset.
EXPO_PUBLIC_LANDING_URL=http://localhost:8082

# Shown next to the signup consent checkbox. Leave blank to show that text without a link.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
