(security) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

easykharcha.com {
	import security
	reverse_proxy landing:80
}

www.easykharcha.com {
	redir https://easykharcha.com{uri} permanent
}

app.easykharcha.com {
	import security
	reverse_proxy web-app:80
}

api.easykharcha.com {
	import security

	# Optional: restrict the Django admin to your own IP(s). Replace the IP below with yours, update
	# the path if ADMIN_URL_PATH in deploy/.env.production isn't the default "manage-ek/", then
	# uncomment both lines.
	# @admin_blocked {
	# 	path /manage-ek/*
	# 	not remote_ip 203.0.113.10
	# }
	# respond @admin_blocked 403

	handle_path /static/* {
		root * /srv/static
		file_server
	}

	handle_path /media/* {
		root * /srv/media
		file_server
	}

	handle {
		reverse_proxy backend:8000
	}
}
