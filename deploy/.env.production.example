# Copy to deploy/.env.production on the server (gitignored, created there only — never committed).
# One comment per line. See deploy/README.md for the first-time setup order.

# --- Django (REQUIRED to fill in) ---
# Generate with: docker compose -f docker-compose.prod.yml run --rm backend python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# --- Django (safe as shown) ---
DEBUG=false
ALLOWED_HOSTS=api.easykharcha.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://app.easykharcha.com
CSRF_TRUSTED_ORIGINS=https://app.easykharcha.com,https://api.easykharcha.com
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
CACHE_LOCATION=/tmp/easykharcha_cache
API_RATE_LIMIT=30/min
SECURE_HSTS_SECONDS=2592000
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
CONSENT_VERSION=1.0
OTP_REQUIRED=false
MAX_BUSINESSES_PER_USER=3
# Django admin path (platform-staff support tool, not business roles) — not /admin/ so it isn't
# guessable. Change this to your own value and keep it secret; see deploy/README.md for the first
# superuser. The trailing slash is added automatically if you leave it off.
ADMIN_URL_PATH=manage-ek/

# --- AI menu reading / recipe suggestions (Step C1, backend/ai/) ---
# Set only on the server — never commit a real key. Processed by the ai/ worker service below, not
# the web backend, so menu reading never blocks a request.
ANTHROPIC_API_KEY=
AI_MODEL_MENU=claude-haiku-5-5
AI_MODEL_RECIPE=claude-haiku-5-5
AI_MODEL_FALLBACK=claude-sonnet-5-5
AI_FAKE=false
AI_DAILY_SCANS_PER_BUSINESS=5
# Whole-deployment monthly spend cap (USD) — once reached, every AI endpoint returns 503 until the
# next calendar month. AI_PRICE_IN/OUT_PER_MTOK are the Haiku-tier list price per 1M tokens at the
# time this was written — check Anthropic's current pricing before trusting these for real budgeting.
AI_MONTHLY_CAP_USD=20
AI_PRICE_IN_PER_MTOK=1.00
AI_PRICE_OUT_PER_MTOK=5.00

# --- Database (REQUIRED: set a real password, then keep it in sync between the two lines below) ---
POSTGRES_DB=easykharcha
POSTGRES_USER=easykharcha
POSTGRES_PASSWORD=
# Same host/user/password/db as the three lines above — "db" is the compose service name, not a real
# hostname. django-environ parses this; the three POSTGRES_* vars above are for the db container itself.
DATABASE_URL=postgres://easykharcha:CHANGE_ME@db:5432/easykharcha
