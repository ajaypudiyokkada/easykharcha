# Copy to deploy/.env.production on the server (gitignored, created there only — never committed).
# One comment per line. See deploy/README.md for the first-time setup order.

# --- Django (REQUIRED to fill in) ---
# Generate with: docker compose -f docker-compose.prod.yml run --rm backend python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# --- Django (safe as shown) ---
DEBUG=false
ALLOWED_HOSTS=api.easykharcha.com
CORS_ALLOWED_ORIGINS=https://app.easykharcha.com
CSRF_TRUSTED_ORIGINS=https://app.easykharcha.com,https://api.easykharcha.com
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
CACHE_BACKEND=django.core.cache.backends.filebased.FileBasedCache
CACHE_LOCATION=/tmp/easykharcha_cache
API_RATE_LIMIT=30/min
SECURE_HSTS_SECONDS=2592000
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=30
CONSENT_VERSION=1.0
OTP_REQUIRED=false
MAX_BUSINESSES_PER_USER=3

# --- Database (REQUIRED: set a real password, then keep it in sync between the two lines below) ---
POSTGRES_DB=easykharcha
POSTGRES_USER=easykharcha
POSTGRES_PASSWORD=
# Same host/user/password/db as the three lines above — "db" is the compose service name, not a real
# hostname. django-environ parses this; the three POSTGRES_* vars above are for the db container itself.
DATABASE_URL=postgres://easykharcha:CHANGE_ME@db:5432/easykharcha
