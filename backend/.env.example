# Copy to backend/.env. .env is gitignored; this file is the only one that's committed.

# Leave unset for local dev — a random value is fine there. Set a real secret before deploying.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DEBUG=true
ALLOWED_HOSTS=*

# Defaults to SQLite (backend/db.sqlite3) if unset — nothing else needed for local dev. Point this at
# the docker-compose.yml Postgres when that's actually wanted:
#   DATABASE_URL=postgres://easykharcha:easykharcha@localhost:5432/easykharcha
DATABASE_URL=

# Comma-separated. Defaults to the two the mobile web dev server uses if unset.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
