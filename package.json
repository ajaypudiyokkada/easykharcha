{
  "name": "easykharcha",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "npm run check:backend && npm run check:mobile && npm run check:sector-copy",
    "check:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check_backend.ps1",
    "check:mobile": "npm --prefix mobile run check",
    "check:sector-copy": "python scripts/check_sector_copy.py",
    "smoke": "python scripts/smoke.py",
    "flow": "node scripts/flow.mjs",
    "responsive": "node scripts/responsive_check.mjs",
    "responsive:selftest": "node scripts/responsive_check.mjs --self-test",
    "verify": "node scripts/verify.mjs verify",
    "verify:ui": "node scripts/verify.mjs verify:ui",
    "verify:full": "node scripts/verify.mjs verify:full",
    "icons": "node scripts/generate_icons.mjs",
    "pwa-check": "node scripts/pwa_check.mjs",
    "build:web": "npm --prefix mobile run build:web && node scripts/patch_web_shell.mjs",
    "serve:web": "node scripts/serve_web.mjs"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5"
  }
}
